{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mostinvisible.com" }],
      "destination": "https://www.mostinvisible.com/:path*",
      "permanent": true
    },
    { "source": "/services", "destination": "/info", "permanent": true },
    { "source": "/case-study", "destination": "/work", "permanent": true },
    { "source": "/case-studies/:slug*", "destination": "/work", "permanent": true },
    { "source": "/projects/:slug*", "destination": "/work", "permanent": true },
    { "source": "/search", "destination": "/blog", "permanent": true }
  ]
}
