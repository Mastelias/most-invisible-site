---
export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  navTheme?: string;
  styles?: string[];
  pageScripts?: string[];
  ogImage?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleAuthor?: string;
}

import { getProjectCount } from "../lib/sanity";

const {
  title,
  description = "Most Invisible® is a design studio based in Montréal, specializing in brand identity, website design, and digital products.",
  bodyClass = "",
  navTheme,
  styles = [],
  pageScripts = [],
  ogImage = "/uploads/og-image.jpg",
  ogType = "website",
  articlePublishedTime,
  articleAuthor,
} = Astro.props;

const workCount = await getProjectCount();

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Most Invisible" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <!-- Site-wide structured data: Organization + WebSite -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.mostinvisible.com/#org",
          "name": "Most Invisible",
          "url": "https://www.mostinvisible.com",
          "logo": "https://www.mostinvisible.com/favicon.svg",
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "contact@mostinvisible.com",
            "contactType": "customer service"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Montréal",
            "addressRegion": "QC",
            "addressCountry": "CA"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://www.mostinvisible.com/#website",
          "url": "https://www.mostinvisible.com",
          "name": "Most Invisible",
          "publisher": { "@id": "https://www.mostinvisible.com/#org" }
        }
      ]
    }
    </script>

    <!-- Global stylesheets (shared by every page) -->
    <link rel="stylesheet" href="/colors_and_type.css?v=36" />
    <link rel="stylesheet" href="/site.css?v=52" />
    <link rel="stylesheet" href="/reveal.css?v=2" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}

    <!-- Gate heading-reveal before first paint to avoid a flash of static text -->
    <script is:inline>document.documentElement.classList.add("reveal-on");</script>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PHFTQ9XR');</script>
  </head>

  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PHFTQ9XR"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- Shared navbar (injected by navbar.js) -->
    <div id="site-navbar" data-theme={navTheme} data-work-count={workCount}></div>

    <slot />

    <!-- Shared scripts on every page -->
    <script src="/navbar.js?v=3" is:inline></script>
    <script src="/footer.js" is:inline></script>
    <script src="/site.js?v=48" is:inline></script>
    {pageScripts.map((src) => <script src={src} is:inline></script>)}
  </body>
</html>
