---
import Layout from "../../layouts/Layout.astro";
import { getPosts, getPost } from "../../lib/sanity";
import { toHTML } from "@portabletext/to-html";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug!);
if (!post) return Astro.redirect("/blog");

// Smart SEO: CMS fields win; auto-generate from existing content if not set.
const metaTitle = post.seoTitle || `${post.title} — Most Invisible`;
const metaDescription = post.seoDescription || post.excerpt;

const siteBase = (Astro.site?.href ?? Astro.url.origin).replace(/\/$/, "");
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.rawDate ?? post.date,
  "url": `${siteBase}/blog/${post.slug}`,
  ...(post.coverImage ? { "image": post.coverImage } : {}),
  "author": {
    "@type": "Person",
    "name": "Elias Serrano",
    "url": `${siteBase}/info`
  },
  "publisher": { "@id": "https://www.mostinvisible.com/#org" }
};

// Body is either Sanity Portable Text (array) or sample HTML (string).
const bodyHtml =
  typeof post.body === "string"
    ? post.body
    : toHTML(post.body as any, {
        components: {
          types: {
            image: ({ value }: any) =>
              value?.url
                ? `<figure class="ba-figure"><img src="${value.url}?w=1600&auto=format&fit=max" alt="${(value.alt || post.title).replace(/"/g, "&quot;")}" loading="lazy" /></figure>`
                : "",
          },
        },
      });

// ─── Table of contents — built from H2s in the rendered body ─────────────────
function slugifyId(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}
const tocEntries: { id: string; text: string }[] = [];
const bodyHtmlWithAnchors = bodyHtml.replace(/<h2>([^<]*)<\/h2>/gi, (_, text) => {
  const id = slugifyId(text);
  tocEntries.push({ id, text });
  return `<h2 id="${id}">${text}</h2>`;
});

// ─── Read Next — keyword scoring from title + excerpt ────────────────────────
const STOP = new Set([
  "a","an","the","and","or","but","in","on","at","to","for","of","with","by",
  "from","up","about","into","is","are","was","were","be","been","have","has",
  "had","do","does","did","will","would","could","should","may","might","it",
  "its","this","that","these","those","i","you","he","she","we","they","what",
  "which","who","how","when","where","why","all","both","each","more","most",
  "other","some","no","not","only","so","than","too","very","just","your",
  "our","their","my","his","her","if","can","get","make","use","your"
]);
function tokenize(t: string): Set<string> {
  return new Set(t.toLowerCase().replace(/[^a-z0-9\s]/g," ").split(/\s+/).filter(w => w.length > 2 && !STOP.has(w)));
}
const titleToks = tokenize(post.title);
const excerptToks = tokenize(post.excerpt || "");
const others = (await getPosts())
  .filter(p => p.slug !== post.slug)
  .map(p => {
    const pt = tokenize(p.title), pe = tokenize(p.excerpt || "");
    let score = 0;
    for (const t of titleToks)   { if (pt.has(t)) score += 3; else if (pe.has(t)) score += 1; }
    for (const t of excerptToks) { if (pt.has(t)) score += 2; else if (pe.has(t)) score += 1; }
    return { p, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ p }) => p);

const readNextCols = [1, 2, 4];
---

<Layout
  title={metaTitle}
  description={metaDescription}
  bodyClass="page-article"
  styles={["/blog.css?v=1", "/blog-article.css?v=4"]}
  ogImage={post.coverImage ?? "/uploads/Design Template showcase.webp"}
  ogType="article"
  articlePublishedTime={post.rawDate}
  articleAuthor="Elias Serrano"
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="ba-hero" data-screen-label="01 Article Hero">
    {post.coverImage ? (
      <div class="ba-hero__bg" style={`background-image:url(${post.coverImage}); background-size:cover; background-position:center;`}></div>
    ) : (
      <div class={`ba-hero__bg ${post.coverStyle}`}></div>
    )}
    <div class="ba-hero__overlay"></div>
    <div class="ba-hero__content">
      <span class="ba-hero__date">{post.date}</span>
      <h1 class="ba-hero__title">{post.title}</h1>
      {post.excerpt && <p class="ba-hero__excerpt">{post.excerpt}</p>}
    </div>
  </section>

  <!-- ══ ARTICLE BODY ══════════════════════════════════════════════════ -->
  <section class="ba-body" data-screen-label="02 Article Body">
    {post.coverImage ? (
      <div class="ba-body__cover-placeholder" style={`background-image:url(${post.coverImage}); background-size:cover; background-position:center;`}></div>
    ) : (
      <div class={`ba-body__cover-placeholder ${post.coverStyle}`}></div>
    )}

    {tocEntries.length >= 3 && (
      <nav class="ba-toc" aria-label="Table of contents">
        <span class="ba-toc__label">Contents</span>
        <ol class="ba-toc__list">
          {tocEntries.map((e, i) => (
            <li class="ba-toc__item">
              <a class="ba-toc__link" href={`#${e.id}`}>
                <span class="ba-toc__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="ba-toc__text">{e.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="ba-body__text" set:html={bodyHtmlWithAnchors} />
  </section>

  <!-- ══ READ NEXT ═════════════════════════════════════════════════════ -->
  {
    others.length > 0 && (
      <section class="ba-next" data-screen-label="03 Read Next">
        <span class="ba-next__label">Read Next</span>
        <div class="ba-next__grid" id="read-next-grid">
          {others.map((p, idx) => (
            <a class="blog-card" href={`/blog/${p.slug}`} style={`grid-column: ${readNextCols[idx]};`}>
              <div class="blog-card__image">
                {p.coverImage ? (
                  <div class="blog-card__img" style={`background-image:url(${p.coverImage}); background-size:cover; background-position:center;`} />
                ) : (
                  <div class={`blog-card__img-placeholder ${p.coverStyle}`} />
                )}
              </div>
              <span class="blog-card__year">({p.date})</span>
              <h2 class="blog-card__title">{p.title}</h2>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- ══ FOOTER ════════════════════════════════════════════════════════ -->
  <div id="site-footer"></div>

  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
</Layout>
